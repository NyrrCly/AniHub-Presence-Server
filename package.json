{
  "name": "anihub-presence-server",
  "version": "1.0.1",
  "description": "AniHub Presence Server is a Discord Rich Presence application for AniHub.",
  "type": "module",
  "author": {
    "name": "NyrrCly"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && copyfiles -u 1 assets/**/* dist/assets",
    "start": "npm run build && electron dist/main.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "artifactName": "AniHub-Presence-${version}.${ext}",
    "appId": "com.nrc.anihub-presence",
    "productName": "AniHub-Presence",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/logo.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/logo.png",
      "category": "Utility"
    },
    "nsis": {
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "uninstallDisplayName": "AniHub-Presence",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "AniHub-Presence",
      "runAfterFinish": true
    }
  },
  "private": true,
  "devDependencies": {
    "@types/discord-rpc": "^4.0.11",
    "copyfiles": "^2.4.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chance": "^1.1.13",
    "rpc-nyrrcly": "^4.0.2"
  }
}
